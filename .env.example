# App Mode
# Options: demo, development, production
VITE_APP_MODE=demo

# Firebase Configuration
# Get these from Firebase Console -> Project Settings
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Cloudinary Configuration
# Get these from Cloudinary Dashboard
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key
VITE_CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Meta (Facebook/Instagram) Configuration
# Get these from Meta for Developers
VITE_META_APP_ID=your_meta_app_id
VITE_META_APP_SECRET=your_meta_app_secret

# TikTok Configuration
# Get these from TikTok for Developers
VITE_TIKTOK_CLIENT_KEY=your_tiktok_client_key
VITE_TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# AI Configuration (Optional)
# Get these from OpenAI or Anthropic
VITE_AI_API_KEY=your_ai_api_key
VITE_AI_PROVIDER=openai

# Vercel Configuration (for deployment)
# These are set automatically in Vercel
VERCEL_URL=
VERCEL_ENV=

# Default Settings
VITE_DEFAULT_TIMEZONE=Indian/Maldives
VITE_DEFAULT_LANGUAGE=en
VITE_DEFAULT_CURRENCY=MVR
