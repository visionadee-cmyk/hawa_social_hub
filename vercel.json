{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "env": {
    "VITE_APP_MODE": "@app_mode",
    "VITE_FIREBASE_API_KEY": "@firebase_api_key",
    "VITE_FIREBASE_AUTH_DOMAIN": "@firebase_auth_domain",
    "VITE_FIREBASE_PROJECT_ID": "@firebase_project_id",
    "VITE_FIREBASE_STORAGE_BUCKET": "@firebase_storage_bucket",
    "VITE_FIREBASE_MESSAGING_SENDER_ID": "@firebase_messaging_sender_id",
    "VITE_FIREBASE_APP_ID": "@firebase_app_id",
    "VITE_CLOUDINARY_CLOUD_NAME": "@cloudinary_cloud_name",
    "VITE_CLOUDINARY_API_KEY": "@cloudinary_api_key",
    "VITE_CLOUDINARY_API_SECRET": "@cloudinary_api_secret",
    "VITE_META_APP_ID": "@meta_app_id",
    "VITE_META_APP_SECRET": "@meta_app_secret",
    "VITE_TIKTOK_CLIENT_KEY": "@tiktok_client_key",
    "VITE_TIKTOK_CLIENT_SECRET": "@tiktok_client_secret",
    "VITE_AI_API_KEY": "@ai_api_key",
    "VITE_AI_PROVIDER": "@ai_provider",
    "VITE_DEFAULT_TIMEZONE": "@default_timezone",
    "VITE_DEFAULT_LANGUAGE": "@default_language",
    "VITE_DEFAULT_CURRENCY": "@default_currency"
  }
}
